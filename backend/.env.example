CORS_ORIGINS=http://localhost:5173

# E-mail extraction. With a key set, Claude reads the e-mails; without it, keyword rules are used.
ANTHROPIC_API_KEY=
# auto | claude | rules
DCR_EXTRACTOR=auto
DCR_CLAUDE_MODEL=claude-opus-5

# Tracker workbook the app reads and writes (default: resources/output/DCR_Tracker.xlsx, copied from resources/template_SOP.xlsx)
DCR_TRACKER_PATH=
